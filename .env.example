# ==============================================================================
# Variables de Entorno - TPI Fulvo' (Plantilla para Desarrollo Local)
# ==============================================================================
# Para desarrollo local, docker compose utiliza valores por defecto funcionales.
# Si necesitas personalizar algún puerto o credencial en tu máquina:
# 1. Copia este archivo: cp .env.example .env
# 2. Modifica las variables deseadas (ej. DB_PORT_HOST=5433 si 5432 está ocupado).
# ==============================================================================

# --- PostgreSQL 16 ---
POSTGRES_DB=fulvo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Puerto mapeado en el host (cambiar a 5433 si tienes PostgreSQL nativo instalado):
DB_PORT_HOST=5432

# --- Keycloak 26.5.0 (Servidor de Identidad OIDC) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT_HOST=8090

# --- Mailpit (Servidor SMTP & Bandeja Web de Correos) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- WireMock (Simulador Offline Nominatim & Open-Meteo) ---
WIREMOCK_PORT_HOST=8086
