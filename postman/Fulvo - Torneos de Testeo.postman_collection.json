			"name": "04 - PR 15 - Reemplazo Exitoso de Jugador (FN-11 / RN-11)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Reemplazo registrado correctamente\", function () {",
							"    var data = pm.response.json();",
							"    pm.expect(data.equipoId).to.eql(1);",
							"    pm.expect(data.cambiosRealizados).to.be.at.least(1);",
							"    pm.expect(data.cambiosRestantes).to.eql(5 - data.cambiosRealizados);",
							"    pm.expect(data.nuevoJugadorId).to.be.a(\"number\");",
							"});"
