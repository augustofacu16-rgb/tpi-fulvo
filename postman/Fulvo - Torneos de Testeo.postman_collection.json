	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Fulvo - Torneos de Testeo y PR #15",
		"description": "Colección de pruebas para:\n1) Los 3 torneos de testeo (Liga Iniciada 10/10, Liga Abierta 3/10, Llaves Iniciada 8/8).\n2) Endpoints de la PR #15 (Subsección 3.4): Reemplazos de jugadores (FN-11, RN-11) y Bajas/Descalificaciones (FN-13, RN-04).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Torneos - Listar todos los torneos",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Retorna los 3 torneos con sus estados correspondientes\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.length).to.be.at.least(3);",
							"    var t1 = jsonData.find(t => t.id === 1);",
							"    pm.expect(t1.estado).to.eql(\"INICIADO\");",
							"    pm.expect(t1.equiposInscriptos).to.eql(10);",
							"    var t2 = jsonData.find(t => t.id === 2);",
							"    pm.expect(t2.estado).to.eql(\"ABIERTO_INSCRIPCION\");",
							"    pm.expect(t2.equiposInscriptos).to.eql(3);",
							"    var t3 = jsonData.find(t => t.id === 3);",
							"    pm.expect(t3.estado).to.eql(\"INICIADO\");",
							"    pm.expect(t3.equiposInscriptos).to.eql(8);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{gateway_url}}/v1/torneos",
					"host": [
						"{{gateway_url}}"
					],
					"path": [
						"v1",
						"torneos"
					]
				}
			},
			"response": []
		},
