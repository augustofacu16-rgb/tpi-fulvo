{
  "info": {
    "_postman_id": "fulvo-auth-collection",
    "name": "Fulvo API - Quickstart",
    "description": "Colección inicial para autenticación contra Keycloak y pruebas del API Gateway en TPI Fulvo'",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Autenticación Keycloak",
      "item": [
        {
          "name": "Login - Organizador (admin1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.environment.set(\"token_organizador\", res.access_token);",
                  "    console.log(\"Token de Organizador actualizado en el entorno.\");",
                  "} else {",
                  "    console.error(\"No se recibio access_token en la respuesta:\", res);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "fulvo-backend",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "admin1",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/fulvo-realm/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "fulvo-realm",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Obtiene un token JWT con rol ROL_ORGANIZADOR y lo guarda automáticamente en la variable de entorno `token_organizador`."
          },
          "response": []
        },
