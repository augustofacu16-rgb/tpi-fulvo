		{
			"name": "04 - Torneos - Validación de payload inválido (RFC 7807 400)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Responde HTTP 400 Bad Request\", function () {",
							"    pm.response.to.have.status(400);",
							"});",
							"",
							"pm.test(\"Estructura RFC 7807 ProblemDetail válida\", function () {",
							"    const err = pm.response.json();",
							"    pm.expect(err.status).to.eql(400);",
							"    pm.expect(err.correlationId).to.be.a(\"string\").and.not.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
