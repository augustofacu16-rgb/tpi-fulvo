							"pm.test(\"Responde HTTP 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Mailpit registra mensajes en bandeja\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data).to.have.property(\"messages\");",
							"});"
