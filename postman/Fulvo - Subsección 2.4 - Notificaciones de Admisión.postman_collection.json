{
	"info": {
		"_postman_id": "e4f81c90-9b34-4bc6-8d4e-7bfae6912345",
		"name": "Fulvo - Subsección 2.4 - Notificaciones de Admisión",
		"description": "Pruebas funcionales de integración inter-servicio para la Subsección 2.4 (FN-14, RN-12): RestClient asíncrono desde servicio-torneos hacia servicio-notificaciones y entrega vía Mailpit.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Torneos - Confirmación de postulación (FN-14)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Responde HTTP 202 Accepted\", function () {",
							"    pm.response.to.have.status(202);",
							"});",
							"",
							"pm.test(\"Confirma despacho asíncrono al destinatario\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data.destinatario).to.eql(\"fanatico@fulvo.com\");",
							"    pm.expect(data.nombreEquipo).to.eql(\"Deportivo Fulvo\");",
							"});",
							"",
							"pm.test(\"Propaga cabecera X-Correlation-ID\", function () {",
							"    pm.expect(pm.response.headers.get(\"X-Correlation-ID\"))",
							"        .to.be.a(\"string\").and.not.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"emailDestinatario\": \"fanatico@fulvo.com\",\n  \"nombreEquipo\": \"Deportivo Fulvo\",\n  \"nombreTorneo\": \"Torneo Apertura 2026\"\n}"
				},
				"url": {
					"raw": "{{torneos_url}}/v1/torneos/notificaciones/postulacion",
					"host": [
						"{{torneos_url}}"
					],
					"path": [
						"v1",
						"torneos",
						"notificaciones",
						"postulacion"
					]
				}
			},
			"response": []
		},
		{
			"name": "02 - Torneos - Admisión aprobada (RN-12 / FN-05)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Responde HTTP 202 Accepted\", function () {",
							"    pm.response.to.have.status(202);",
							"});",
							"",
							"pm.test(\"Confirma resolución APROBADA\", function () {",
							"    const data = pm.response.json();",
							"    pm.expect(data.resolucion).to.eql(\"APROBADA\");",
							"    pm.expect(data.destinatario).to.eql(\"delegado@fulvo.com\");",
							"});",
							"",
							"pm.test(\"Propaga cabecera X-Correlation-ID\", function () {",
							"    pm.expect(pm.response.headers.get(\"X-Correlation-ID\"))",
							"        .to.be.a(\"string\").and.not.empty;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"emailDestinatario\": \"delegado@fulvo.com\",\n  \"nombreEquipo\": \"Deportivo Fulvo\",\n  \"nombreTorneo\": \"Torneo Apertura 2026\",\n  \"aprobada\": true\n}"
				},
				"url": {
					"raw": "{{torneos_url}}/v1/torneos/notificaciones/admision",
					"host": [
						"{{torneos_url}}"
					],
					"path": [
						"v1",
						"torneos",
						"notificaciones",
						"admision"
					]
				}
			},
			"response": []
