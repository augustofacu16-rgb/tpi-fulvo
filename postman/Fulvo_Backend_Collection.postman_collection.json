{
  "info": {
    "_postman_id": "fulvo-backend-collection-5-5",
    "name": "Fulvo Backend - Suite Integral E2E (Subsección 5.5)",
    "description": "Colección automatizada integral para TPI Fulvo' con auto-login en Keycloak, extracción dinámica de tokens/IDs, enrutamiento perimetral por API Gateway y aserciones pm.test() para los escenarios oficiales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 1. Sufijo único de corrida para evitar colisiones de DNI/nombres/coordenadas",
          "if (!pm.environment.get('run_suffix')) {",
          "    pm.environment.set('run_suffix', String(Date.now()).slice(-6));",
          "}",
          "",
          "// 2. Helper para verificar expiración de JWT",
          "function isJwtExpired(token) {",
          "    if (!token) return true;",
          "    try {",
          "        var payloadPart = token.split('.')[1];",
          "        var base64 = payloadPart.replace(/-/g, '+').replace(/_/g, '/');",
          "        var jsonPayload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(base64)));",
          "        var nowSec = Math.floor(Date.now() / 1000);",
          "        return !jsonPayload.exp || (jsonPayload.exp - 30) <= nowSec;",
          "    } catch (e) {",
          "        return true;",
          "    }",
          "}",
          "",
          "function extractSub(token) {",
          "    try {",
          "        var payloadPart = token.split('.')[1];",
          "        var base64 = payloadPart.replace(/-/g, '+').replace(/_/g, '/');",
          "        var jsonPayload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(base64)));",
          "        return jsonPayload.sub || '';",
          "    } catch (e) {",
          "        return '';",
          "    }",
          "}",
          "",
          "// 3. Auto-login en Keycloak para los 4 roles si algún token falta o expiró",
          "var keycloakUrl = pm.environment.get('keycloak_url') || 'http://localhost:8090';",
          "var roles = [",
          "    { user: 'admin1', envVar: 'token_organizador' },",
          "    { user: 'delegado1', envVar: 'token_delegado' },",
          "    { user: 'arbitro1', envVar: 'token_arbitro' },",
          "    { user: 'fanatico1', envVar: 'token_fanatico' }",
          "];",
          "",
          "roles.forEach(function (r) {",
          "    var current = pm.environment.get(r.envVar);",
          "    if (isJwtExpired(current)) {",
          "        pm.sendRequest({",
          "            url: keycloakUrl + '/realms/fulvo-realm/protocol/openid-connect/token',",
          "            method: 'POST',",
          "            header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "            body: {",
          "                mode: 'urlencoded',",
          "                urlencoded: [",
          "                    { key: 'client_id', value: 'fulvo-backend' },",
          "                    { key: 'grant_type', value: 'password' },",
          "                    { key: 'username', value: r.user },",
          "                    { key: 'password', value: 'admin123' }",
          "                ]",
          "            }",
          "        }, function (err, res) {",
          "            if (!err && res.code === 200) {",
          "                var data = res.json();",
          "                if (data.access_token) {",
          "                    pm.environment.set(r.envVar, data.access_token);",
          "                    if (r.user === 'arbitro1') {",
          "                        pm.environment.set('arbitro_sub', extractSub(data.access_token));",
          "                    }",
          "                }",
          "            }",
          "        });",
          "    } else if (r.user === 'arbitro1' && !pm.environment.get('arbitro_sub')) {",
          "        pm.environment.set('arbitro_sub', extractSub(current));",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Autenticación Keycloak y Health",
      "item": [
        {
          "name": "EP-01 - Login Organizador (admin1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('EP-01: Keycloak retorna 200 OK y access_token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "    pm.environment.set('token_organizador', json.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "fulvo-backend", "type": "text" },
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "admin1", "type": "text" },
                { "key": "password", "value": "admin123", "type": "text" }
              ]
            },
            "url": "{{keycloak_url}}/realms/fulvo-realm/protocol/openid-connect/token"
          }
        },
