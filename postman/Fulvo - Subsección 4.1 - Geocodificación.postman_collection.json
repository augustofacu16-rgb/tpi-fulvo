							"pm.test(\"Resuelve mediante fallback manual\", function () {",
							"    pm.response.to.have.status(201);",
							"",
							"    const resultado = pm.response.json();",
							"    pm.expect(resultado.fuente).to.eql(\"MANUAL\");",
							"    pm.expect(resultado.latitud).to.eql(-31.4167);",
							"    pm.expect(resultado.longitud).to.eql(-64.1833);",
							"});"
