	"item": [
		{
			"name": "01 - Registrar árbitro",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Crea el árbitro con HTTP 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Devuelve los datos del árbitro\", function () {",
							"    const arbitro = pm.response.json();",
							"",
							"    pm.expect(arbitro.dni).to.eql(\"35123456\");",
							"    pm.expect(arbitro.nombre).to.eql(\"Martín\");",
							"    pm.expect(arbitro.apellido).to.eql(\"Pérez\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"dni\": \"35123456\",\n  \"usuarioId\": \"1\",\n  \"nombre\": \"Martín\",\n  \"apellido\": \"Pérez\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{operaciones_url}}/v1/arbitros",
					"host": [
						"{{operaciones_url}}"
					],
					"path": [
						"v1",
						"arbitros"
					]
				}
			},
			"response": []
		},
